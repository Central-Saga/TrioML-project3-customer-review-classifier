<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_navy"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- Offline Status -->
        <TextView
            android:id="@+id/tvOfflineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE MODE"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Review Buddy"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="AI Customer Review Classifier"
            android:textColor="@color/accent_teal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pahami sentimen pelanggan dengan mudah. Masukkan review dan biarkan AI menganalisisnya."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- Input Label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInputLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Review pelanggan"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEXT INPUT"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- Review Input with focus animation -->
        <EditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_review_input"
            android:elevation="2dp"
            android:stateListAnimator="@animator/lift_on_interaction"
            android:gravity="top|start"
            android:hint="Contoh: Barangnya bagus dan pengiriman cepat..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:maxLines="7"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:fontFamily="sans"
            android:autofillHints="off" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Review diproses langsung di perangkatmu."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Prediction Button with shadow and animation -->
        <Button
            android:id="@+id/btnPredict"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_predict_button"
            android:backgroundTint="@null"
            android:elevation="3dp"
            android:stateListAnimator="@animator/lift_on_interaction"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="âœ¦  ANALISIS SENTIMEN"
            android:textAllCaps="false"
            android:textColor="@color/background_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Prediction Result Card -->
        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_result_card"
            android:elevation="3dp"
            android:stateListAnimator="@animator/lift_on_interaction"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HASIL ANALISIS"
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/tvSentiment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="â€”"
                android:textColor="@color/text_primary"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="Confidence: â€”"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="14dp"
                android:background="@color/divider_color" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Hasil klasifikasi menggunakan model AI lokal"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Powered by IndoBERT â€¢ ONNX Runtime"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="ON-DEVICE AI â€¢ NO INTERNET REQUIRED"
            android:textColor="@color/accent_teal"
            android:textSize="10sp"
            android:letterSpacing="0.05" />

    </LinearLayout>

</ScrollView>
